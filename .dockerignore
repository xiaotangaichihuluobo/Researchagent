backend/models/

# ============ 前端 / 文档 / 测试（后端镜像不需要） ============
frontend/
tests/
samples/
docs/

# ============ 密钥 / 环境变量（切勿打进镜像） ============
.env
.env.*
!.env.prod.example

# ============ IDE / 系统 ============
.git/
.gitignore
.idea/
.vscode/
.DS_Store
Thumbs.db

