# ============================================================================
# .env.prod.example —— 服务器生产环境配置模板（放在仓库根目录）
#
# 用法：cp .env.prod.example .env.prod   （顶部"复制 config.py 所需值"请对照你的
#       .env.local / 部署机器实际情况填写）
#
# .env.prod 已被 .gitignore 忽略，不会进仓库——真实密钥只存在于服务器。
# 启动：docker compose --env-file .env.prod up -d
# ============================================================================

# ── 数据库（PostgreSQL；容器内地址=服务名，内部端口 5432）──
DB_HOST=postgres
DB_PORT=5432
DB_NAME=researchagent
DB_USER=researchagent_user
DB_PASSWORD=CHANGE_ME_PG_PASSWORD
# 宿主需对外开放的外部映射端口（可选，便于宿主机之外访问；默认 5433）
DB_EXTERNAL_PORT=5433

# ── Milvus（容器内地址=服务名，内部端口 19530；对外 19531）──
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ── 通义千问（必填：全部结构化输出走它，实测支持 json_schema strict）──
QWEN_API_KEY=sk-CHANGE_ME_QWEN
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo

# ── DeepSeek（可选：端点已登记，当前无 Agent 路由到它）──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_CHAT=deepseek-chat
DEEPSEEK_MODEL_CODER=deepseek-coder

# ── 本地模型权重路径（容器内，指向挂载卷 /models；镜像内 /app/backend 无权重）──
# 运行时代码发现缺失会自动从 HF 下载到这些路径
BGE_M3_MODEL_PATH=/models/embedding/bge-m3
RERANKER_MODEL_PATH=/models/reranker/bge-reranker-large
CLASSIFIER_MODEL_PATH=/models/classifier/all-MiniLM-L6-v2
# ← query-classifier-finetuned 不会自动下载：请把训练好的微调权重放到
#   服务器 <仓库>/models/classifier/query-classifier-finetuned/ 供挂载
FINETUNED_CLASSIFIER_PATH=/models/classifier/query-classifier-finetuned

# ── JWT（必填：签发登录令牌）──
JWT_SECRET_KEY=CHANGE_ME_JWT

# ── Web 搜索（可选；留空自动用免费的 DuckDuckGo）──
TAVILY_API_KEY=

# ── 国内下载加速：模型权重走 hf-mirror.com 镜像（大陆服务器必需）──
HF_ENDPOINT=https://hf-mirror.com

# ── 应用 ──
APP_ENV=prod
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── MinIO（Milvus 向量文件存储；可保持默认与 compose 一致）──
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin